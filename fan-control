# Fan controller for Lenovo ThinkSystem SR650 (XClarity Controller).
# Uses local OpenIPMI only; Lenovo raw fan commands are undocumented.
emulate -LR zsh

if (( EUID != 0 )); then
    print -u2 -- 'fan-control: root required'
    exit 1
fi

# Restore XClarity automatic fan control whenever the program exits normally.
trap '
    integer attempt
    for attempt in 1 2 3; do
        if timeout 10 ipmitool -I open raw 0x3a 0x07 0xff 0xff 0x00 >/dev/null 2>&1; then
            print -r -- "mouse-fanguard: XClarity automatic cooling restored"
            break
        fi
        print -u2 -- "fan-control: WARNING: automatic cooling restore failed (attempt $attempt)"
        sleep 1
    done
' EXIT
trap 'exit 0' INT TERM HUP

# The *highest CPU temperature* controls the fan curve. Other sensors have
# separate safety limits (PCH is already ~30 C when the CPUs are idle).
# Low:    CPU <30 C, ~6000 RPM (0x56, estimated from measured settings).
# Medium: CPU 30..59 C, ~9000 RPM (0x8a, user-tested).
# Auto:   CPU >=60 C, or another component in danger, or bad sensor data.
# Hysteresis: resume manual <=55 C; switch medium -> low <=27 C.
mode=unknown
cooldown=0
last_problem=''

while true; do
    problem=''
    readings=$(timeout 10 ipmitool -I open sdr type Temperature 2>/dev/null) || problem='cannot read BMC sensors'

    integer cpu1=0 cpu2=0 dimms=0 pch=0 ambient=0 exhaust=0 overtemp=0
    integer cpu1_temp=-1 cpu2_temp=-1 dimm_max=-1 pch_temp=-1 ambient_temp=-1 exhaust_temp=-1
    integer temperature=0 limit=0 cpu_max=0

    if [[ -z $problem ]]; then
        for line in ${(f)readings}; do
            IFS='|' read -rA fields <<< "$line"
            (( ${#fields} == 5 )) || continue

            name=${fields[1]//[[:space:]]/}
            state=${fields[3]//[[:space:]]/}
            value=${fields[5]//[[:space:]]/}

            if [[ $name == *OverTemp ]]; then
                (( overtemp++ ))
                if [[ $state != ok || $value != TransitiontoOK ]]; then
                    problem="hardware overtemperature alert: $name ($value)"
                    break
                fi
                continue
            fi

            case $name in
                CPU1Temp)    limit=60; (( cpu1++ )) ;;
                CPU2Temp)    limit=60; (( cpu2++ )) ;;
                DIMM*Temp)
                    [[ $value == NoReading ]] && continue
                    limit=60
                    (( dimms++ ))
                    ;;
                PCHTemp)     limit=60; (( pch++ )) ;;
                AmbientTemp) limit=38; (( ambient++ )) ;;
                ExhaustTemp) limit=50; (( exhaust++ )) ;;
                *) continue ;;
            esac

            if [[ $state != ok || $value != <->degreesC ]]; then
                problem="invalid sensor: $name ($value, $state)"
                break
            fi

            temperature=${value%degreesC}
            case $name in
                CPU1Temp)    cpu1_temp=$temperature ;;
                CPU2Temp)    cpu2_temp=$temperature ;;
                DIMM*Temp)   (( temperature > dimm_max )) && dimm_max=$temperature ;;
                PCHTemp)     pch_temp=$temperature ;;
                AmbientTemp) ambient_temp=$temperature ;;
                ExhaustTemp) exhaust_temp=$temperature ;;
            esac

            if (( temperature >= limit )); then
                problem="$name = ${temperature} C (safety limit ${limit} C)"
                break
            fi
        done

        if [[ -z $problem ]] && (( cpu1 != 1 || cpu2 != 1 || dimms != 12 || pch != 1 || ambient != 1 || exhaust != 1 || overtemp != 10 )); then
            problem="missing sensors (CPU=$cpu1/$cpu2 DIMM=$dimms PCH=$pch ambient=$ambient exhaust=$exhaust alarms=$overtemp)"
        fi
    fi

    target=''
    if [[ -n $problem ]]; then
        cooldown=1
        target=auto
        if [[ $problem != $last_problem ]]; then
            print -u2 -- "fan-control: $problem; returning control to XClarity"
        fi
    else
        cpu_max=$(( cpu1_temp > cpu2_temp ? cpu1_temp : cpu2_temp ))

        # Once a threshold triggers AUTO, wait for a 5 C safety margin
        # before taking manual control again. Avoid rapid AUTO/manual flapping.
        if (( cooldown && (cpu_max > 55 || dimm_max > 55 || pch_temp > 55 || ambient_temp > 33 || exhaust_temp > 45) )); then
            target=auto
        else
            cooldown=0
            if (( cpu_max < 30 )); then
                # Medium -> low hysteresis avoids switching repeatedly at 30 C.
                if [[ $mode == medium ]] && (( cpu_max > 27 )); then
                    target=medium
                else
                    target=low
                fi
            else
                target=medium
            fi
        fi
    fi
    last_problem=$problem

    if [[ $target != $mode ]]; then
        case $target in
            low)
                command=(raw 0x3a 0x07 0xff 0x56 0x01)
                ;;
            medium)
                command=(raw 0x3a 0x07 0xff 0x8a 0x01)
                ;;
            auto)
                command=(raw 0x3a 0x07 0xff 0xff 0x00)
                ;;
        esac

        if timeout 10 ipmitool -I open "${command[@]}" >/dev/null 2>&1; then
            mode=$target
            if [[ -z $problem ]]; then
                print -r -- "fan-control: $mode (CPU1=${cpu1_temp} C CPU2=${cpu2_temp} C)"
            else
                print -u2 -- 'fan-control: XClarity automatic cooling requested'
            fi
        else
            print -u2 -- "fan-control: WARNING: failed to set $target; attempting automatic cooling"
            mode=unknown
            if timeout 10 ipmitool -I open raw 0x3a 0x07 0xff 0xff 0x00 >/dev/null 2>&1; then
                mode=auto
                cooldown=1
            else
                print -u2 -- 'fan-control: CRITICAL: cannot restore automatic cooling; retrying'
            fi
        fi
    fi

    sleep 3
done
