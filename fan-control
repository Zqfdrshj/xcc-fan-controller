# XClarity fan controller. The entry point only loads its functions.
emulate -LR zsh

fpath=("${0:A:h}/functions" $fpath)
autoload -Uz run_controller load_config validate_config read_sensors \
    parse_sensors check_sensors select_mode set_mode restore_auto

run_controller "${0:A:h}" "$@"
